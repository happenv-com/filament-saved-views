{
    "name": "happenv-com/filament-saved-views",
    "description": "Reusable saved table views (filters, search) for Filament list pages.",
    "license": "MIT",
    "type": "library",
    "keywords": ["laravel", "filament", "saved-views", "tables"],
    "authors": [
        { "name": "Happenv sp. z o.o.", "homepage": "https://happenv.com" },
        { "name": "webard", "homepage": "https://webard.me" }
    ],
    "require": {
        "php": "^8.3",
        "filament/filament": "^4.0 || ^5.0",
        "livewire/livewire": "^3.0 || ^4.0",
        "illuminate/contracts": "^11.0 || ^12.0 || ^13.0",
        "illuminate/support": "^11.0 || ^12.0 || ^13.0",
        "spatie/eloquent-sortable": "^4.5 || ^5.0",
        "spatie/laravel-package-tools": "^1.16"
    },
    "require-dev": {
        "orchestra/testbench": "^9.0 || ^10.0 || ^11.0",
        "pestphp/pest": "^3.0",
        "pestphp/pest-plugin-livewire": "^3.0"
    },
    "autoload": {
        "psr-4": {
            "Happenv\\FilamentSavedViews\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Happenv\\FilamentSavedViews\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": ["Happenv\\FilamentSavedViews\\FilamentSavedViewsServiceProvider"]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "config": {
        "allow-plugins": { "pestphp/pest-plugin": true },
        "sort-packages": true
    },
    "scripts": {
        "test": "vendor/bin/pest"
    }
}
