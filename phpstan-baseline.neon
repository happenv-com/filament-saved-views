parameters:
	ignoreErrors:
		-
			message: '#^Using nullsafe property access "\?\-\>saved_data" on left side of \?\? is unnecessary\. Use \-\> instead\.$#'
			identifier: nullsafe.neverNull
			count: 1
			path: src/Filament/Concerns/HasSavedViews.php

		-
			message: '#^Call to an undefined method Filament\\Resources\\Pages\\ListRecords\:\:hasUnsavedSavedViewChanges\(\)\.$#'
			identifier: method.notFound
			count: 1
			path: src/FilamentSavedViewsPlugin.php

		-
			message: '#^Parameter \#1 \$view of function view expects view\-string\|null, string given\.$#'
			identifier: argument.type
			count: 1
			path: src/FilamentSavedViewsPlugin.php

		-
			message: '#^Parameter \#1 \$view of function view expects view\-string\|null, string given\.$#'
			identifier: argument.type
			count: 1
			path: src/Livewire/SavedViewsControl.php

		-
			message: '#^Parameter \#1 \$view of function view expects view\-string\|null, string given\.$#'
			identifier: argument.type
			count: 1
			path: tests/Fixtures/SavedViewsListComponent.php

		-
			message: '#^Parameter \#1 \$view of function view expects view\-string\|null, string given\.$#'
			identifier: argument.type
			count: 1
			path: tests/Fixtures/SavedViewsTableComponent.php
